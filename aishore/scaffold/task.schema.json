{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "aishore task (task.toml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "tier",
    "kind",
    "allow"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^T-[0-9]{3,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "type": "integer",
      "enum": [
        1,
        2,
        3
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "feature",
        "fix",
        "refactor",
        "delete",
        "test"
      ]
    },
    "allow": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance_tests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "loc_budget": {
      "type": "integer",
      "minimum": 1
    },
    "max_new_files": {
      "type": "integer",
      "minimum": 0
    },
    "max_new_classes": {
      "type": "integer",
      "minimum": 0
    },
    "replay_may_change": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mutation_min_kill": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "feature",
              "fix"
            ]
          }
        }
      },
      "then": {
        "required": [
          "acceptance_tests"
        ],
        "properties": {
          "acceptance_tests": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "refactor",
              "delete"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "replay_may_change": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
